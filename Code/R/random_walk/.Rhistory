#   rw2_*   posterior with a second-order random-walk prior
#           (* = mean, median, mode of the posterior)
#   gompertz, pspline, ddt
#
# Outputs (random_walk/Results/simulation/):
#   sim_truth.rds          scenario parameters, true density, peaks
#   sim_estimates.rds      one row per replication x start age x method
#   sim_posteriors.rds     RW2 posterior of the mode (mean over replications,
#                          and a few individual replications); used in panel B
#   sim_posteriors_all.rds the same for raw and RW2
#   sim_summary.csv        bias, MAE, RMSE, SD, variance, coverage of the
#                          95% credible interval, credible-interval width
#
# Run from Code/R/random_walk. Uses forked parallelism (macOS / Linux).
# =============================================================================
code_dir = Sys.getenv("MODE_RW_DIR", "~/Desktop/fertility/PDF_of_the_mode/Code/R/random_walk")
setwd(code_dir)
for (f in c("../utils.R", "../mode_posterior.R", "../mode_gompertz.R",
"../mode_pspline.R", "../mode_ddt.R", "../sim_truth_utils.R",
"mode_posterior_rw.R")) source(f)
# ---- Settings ---------------------------------------------------------------
n_rep = as.integer(Sys.getenv("MODE_NREP", 500))
S = 5000
sizes = c(1e3, 1e4, 1e5, 1e6)
start_ages = 40
weights = c(a = 1, b = 0.80, c = 0.70, d = 0.60)
n_keep_post = 5
seed0 = 20261104
n_cores = get_cores()
out_dir = file.path("Results", "simulation")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# ---- True distributions -----------------------------------------------------
scenarios = data.frame(scenario = names(weights), w = unname(weights))
scenarios$label = sprintf("(%s) %s", scenarios$scenario,
ifelse(scenarios$w == 1, "Unimodal",
sprintf("%.0f%% of deaths in the earlier component",
100 * (1 - scenarios$w))))
truth = lapply(seq_len(nrow(scenarios)), function(k) {
w = scenarios$w[k]
pv = find_peaks(w)
grid = data.frame(scenario = scenarios$scenario[k], age = seq(0, max_age, by = 0.05))
grid$f = mix_f(grid$age, w)
list(scenario = scenarios$scenario[k], w = w, peaks = pv$peaks,
valleys = pv$valleys, density = grid)
})
names(truth) = scenarios$scenario
scenarios$peak_ratio = sapply(truth, function(t) {
if (nrow(t$peaks) < 2) NA else min(t$peaks$f) / max(t$peaks$f)
})
saveRDS(list(scenarios = scenarios, truth = truth,
settings = list(M1 = M1, b1 = b1, M2 = M2, b2 = b2, sizes = sizes,
start_ages = start_ages, n_rep = n_rep, S = S)),
file.path(out_dir, "sim_truth.rds"))
schedules = list()
for (k in seq_len(nrow(scenarios))) {
for (N in sizes) {
schedules[[paste(scenarios$scenario[k], N)]] = expected_schedule(scenarios$w[k], N)
}
true_mode = matrix(sapply(truth, function(t) sapply(start_ages, function(st) {
p = t$peaks[t$peaks$x >= st, ]
p$x[which.max(p$f)]
})), nrow = length(start_ages), dimnames = list(start_ages, names(truth)))
# ---- One replication --------------------------------------------------------
families = c("raw", "rw2")
methods = c(paste0(rep(families, each = 3), c("_mean", "_median", "_mode")),
"gompertz", "pspline", "ddt")
run_one = function(task) {
set.seed(seed0 + task$id)
sch = schedules[[paste(task$scenario, task$N)]]
D = rpois(nrow(sch), sch$m * sch$exposure)
safe = function(expr) tryCatch(expr, error = function(e) NA_real_)
# one list element per starting age (the functions return the result
# itself when there is only one)
by_start = function(p) if (length(start_ages) == 1) list(p) else p
post = list(raw = by_start(mode_posterior(sch$age, D, sch$exposure, start_ages,
max_age, S = S)),
rw2 = by_start(mode_posterior_rw(sch$age, D, sch$exposure, start_ages,
max_age, S = S)))
n_st = length(start_ages)
est = matrix(NA_real_, n_st, length(methods), dimnames = list(NULL, methods))
fam_stats = array(NA_real_, c(n_st, length(families), 4),
dimnames = list(NULL, families,
c("cover", "width", "cred_size", "log10_lambda")))
post_probs = list()
for (i in seq_len(n_st)) {
st = start_ages[i]
tm = true_mode[i, task$scenario]
pe = c()
for (fm in families) {
p = post[[fm]][[i]]
pe = c(pe, p$mean, p$median, p$mode)
fam_stats[i, fm, ] = c(p$q025 <= tm && tm <= p$q975, p$q975 - p$q025, p$cred_size,
if (is.null(p$post_log10_lambda)) NA else p$post_log10_lambda)
post_probs[[paste(fm, st)]] = data.frame(family = fm, start_age = st,
age = p$post$age, prob = p$post$prob)
}
est[i, ] = c(pe,
safe(mode_gompertz(sch$age, D, sch$exposure, st, max_age)$mode),
safe(mode_pspline(sch$age, D, sch$exposure, st, max_age)$mode),
safe(mode_ddt(sch$age, D, sch$exposure, st, max_age)$mode))
}
list(est = est, fam_stats = fam_stats, post = do.call(rbind, post_probs))
}
# ---- Run --------------------------------------------------------------------
tasks = expand.grid(rep = seq_len(n_rep), N = sizes, scenario = scenarios$scenario,
stringsAsFactors = FALSE)
tasks$id = seq_len(nrow(tasks))
task_list = split(tasks, tasks$id)
cat("Running", nrow(tasks), "replications on", n_cores, "cores\n")
t0 = Sys.time()
res = par_lapply(task_list, run_one, n_cores, "Simulation")
cat("Done in", format(Sys.time() - t0), "\n")
failed = sapply(res, inherits, "try-error")
if (any(failed)) {
warning(sum(failed), " replications failed; first error: ", res[[which(failed)[1]]])
}
ok = which(!failed)
# ---- Assemble ---------------------------------------------------------------
n_st = length(start_ages)
est = do.call(rbind, lapply(ok, function(j) {
r = res[[j]]
tk = tasks[j, ]
fam = sub("_.*", "", methods)
fam_idx = match(fam, families)
stat = function(name) {
v = matrix(NA_real_, n_st, length(methods))
for (m in which(!is.na(fam_idx))) v[, m] = r$fam_stats[, fam_idx[m], name]
as.vector(v)
}
data.frame(scenario = tk$scenario, N = tk$N, rep = tk$rep,
start_age = rep(start_ages, times = length(methods)),
method = rep(methods, each = n_st),
estimate = as.vector(r$est),
cover = stat("cover"), width = stat("width"), cred_size = stat("cred_size"),
log10_lambda = stat("log10_lambda"))
}))
est$true_mode = true_mode[cbind(match(est$start_age, start_ages),
match(est$scenario, scenarios$scenario))]
est$error = est$estimate - est$true_mode
saveRDS(est, file.path(out_dir, "sim_estimates.rds"))
post_long = do.call(rbind, lapply(ok, function(j) {
tk = tasks[j, ]
data.frame(scenario = tk$scenario, N = tk$N, rep = tk$rep, res[[j]]$post)
}))
key = paste(post_long$family, post_long$scenario, post_long$N, post_long$start_age,
post_long$age)
n_ok = table(paste(tasks$scenario[ok], tasks$N[ok]))
sums = rowsum(post_long$prob, key)
parts = do.call(rbind, strsplit(rownames(sums), " "))
post_mean = data.frame(family = parts[, 1], scenario = parts[, 2],
N = as.numeric(parts[, 3]), start_age = as.numeric(parts[, 4]),
age = as.numeric(parts[, 5]), prob = sums[, 1])
post_mean$prob = post_mean$prob / as.numeric(n_ok[paste(post_mean$scenario, post_mean$N)])
post_mean = post_mean[order(post_mean$family, post_mean$scenario, post_mean$N,
post_mean$start_age, post_mean$age), ]
post_ind = post_long[post_long$rep <= n_keep_post, ]
saveRDS(list(mean = post_mean, individual = post_ind),
file.path(out_dir, "sim_posteriors_all.rds"))
# RW2 only, in the layout read by ../sim_plot_utils.R (panel B)
saveRDS(list(mean = post_mean[post_mean$family == "rw2", -1],
individual = post_ind[post_ind$family == "rw2", names(post_ind) != "family"]),
file.path(out_dir, "sim_posteriors.rds"))
# ---- Summary table ----------------------------------------------------------
g = split(est, list(est$scenario, est$N, est$start_age, est$method), drop = TRUE)
summ = do.call(rbind, lapply(g, function(z) {
data.frame(scenario = z$scenario[1], N = z$N[1], start_age = z$start_age[1],
method = z$method[1], true_mode = z$true_mode[1], n = nrow(z),
n_failed = sum(!is.finite(z$estimate)),
bias = mean(z$error, na.rm = TRUE),
mae = mean(abs(z$error), na.rm = TRUE),
rmse = sqrt(mean(z$error^2, na.rm = TRUE)),
sd = sd(z$estimate, na.rm = TRUE),
variance = var(z$estimate, na.rm = TRUE),
coverage = mean(z$cover),
mean_width = mean(z$width),
mean_cred_size = mean(z$cred_size),
mean_log10_lambda = mean(z$log10_lambda))
}))
summ = summ[order(summ$scenario, summ$N, summ$start_age, summ$method), ]
write.csv(summ, file.path(out_dir, "sim_summary.csv"), row.names = FALSE)
cat("Saved results to", out_dir, "\n")
# =============================================================================
# 02_empirical_rw.R
# Empirical application: modal age at death in the HMD countries by sex and
# year, with the RW2 posterior (mean, median, mode, 95% interval) and the
# Gompertz, P-spline and DDT benchmarks, at starting ages 50, 60 and 70.
# The question is how consistent each method's estimate is across starting
# ages.
#
# Outputs (random_walk/Results/empirical/):
#   point_estimates.rds / .csv    one row per country x sex x year x start
#                                 age x method (estimate; 95% interval for
#                                 the RW2 rows)
#   posterior_summary.rds / .csv  RW2 posterior summaries
#   posterior_int.rds             RW2 P(mode = x | data) on integer ages
#
# Run from Code/R/random_walk. Uses forked parallelism (macOS / Linux).
# =============================================================================
code_dir = Sys.getenv("MODE_RW_DIR", "~/Desktop/fertility/PDF_of_the_mode/Code/R/random_walk")
setwd(code_dir)
for (f in c("../utils.R", "../mode_posterior.R", "../mode_gompertz.R",
"../mode_pspline.R", "../mode_ddt.R", "mode_posterior_rw.R")) source(f)
# ---- Settings ---------------------------------------------------------------
data_dir = file.path("..", "..", "data")
countries = c("Denmark", "France", "Italy", "Japan", "Netherlands", "US")
first_year = 1960
last_year = as.integer(Sys.getenv("MODE_LAST_YEAR", 9999))
start_ages = c(50, 60, 70)
max_age = 110
S = 1e4
seed0 = 20261107
n_cores = get_cores()
out_dir = file.path("Results", "empirical")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
hmd = do.call(rbind, lapply(countries, load_country, data_dir = data_dir))
hmd = hmd[hmd$year >= first_year & hmd$year <= last_year, ]
tasks = unique(hmd[, c("country", "sex", "year")])
tasks = tasks[order(tasks$country, tasks$sex, tasks$year), ]
tasks$id = seq_len(nrow(tasks))
rownames(tasks) = NULL
# ---- One population-year ----------------------------------------------------
run_one = function(k) {
tk = tasks[k, ]
set.seed(seed0 + tk$id)
y = hmd[hmd$country == tk$country & hmd$sex == tk$sex & hmd$year == tk$year, ]
key = data.frame(country = tk$country, sex = tk$sex, year = tk$year)
safe = function(expr) tryCatch(expr, error = function(e) NA_real_)
pp = mode_posterior_rw(y$age, y$deaths, y$exposure, start_ages, max_age, S = S)
pe = list()
ps = list()
pi = list()
for (st in start_ages) {
p = pp[[as.character(st)]]
i = as.character(st)
pe[[i]] = data.frame(key, start_age = st,
method = c("rw2_mean", "rw2_median", "rw2_mode", "gompertz", "pspline", "ddt"),
estimate = c(p$mean, p$median, p$mode,
safe(mode_gompertz(y$age, y$deaths, y$exposure, st, max_age)$mode),
safe(mode_pspline(y$age, y$deaths, y$exposure, st, max_age)$mode),
safe(mode_ddt(y$age, y$deaths, y$exposure, st, max_age)$mode)),
lower = c(rep(p$q025, 3), NA, NA, NA),
upper = c(rep(p$q975, 3), NA, NA, NA))
ps[[i]] = data.frame(key, start_age = st, map = p$map, p_map = p$p_map,
mean = p$mean, median = p$median, mode = p$mode, q025 = p$q025, q975 = p$q975,
cred_lo = min(p$cred_set), cred_hi = max(p$cred_set), cred_size = p$cred_size,
cred_contiguous = p$cred_contiguous, exp_local_modes = p$exp_local_modes,
exp_major_modes = p$exp_major_modes, p_multimodal = p$p_multimodal,
post_log10_lambda = p$post_log10_lambda, last_age = p$last_age)
post = p$post[p$post$prob > 0, ]
pi[[i]] = data.frame(key, start_age = st, age = post$age, prob = post$prob)
}
list(pe = do.call(rbind, pe), ps = do.call(rbind, ps), pi = do.call(rbind, pi))
}
# ---- Run --------------------------------------------------------------------
cat("Running", nrow(tasks), "population-years on", n_cores, "cores\n")
t0 = Sys.time()
res = par_lapply(seq_len(nrow(tasks)), run_one, n_cores, "HMD")
cat("Done in", format(Sys.time() - t0), "\n")
failed = sapply(res, inherits, "try-error")
if (any(failed)) {
warning(sum(failed), " population-years failed: ",
paste(apply(tasks[failed, 1:3], 1, paste, collapse = " "), collapse = "; "))
res = res[!failed]
}
grab = function(name) do.call(rbind, lapply(res, `[[`, name))
point = grab("pe")
summ = grab("ps")
saveRDS(point, file.path(out_dir, "point_estimates.rds"))
write.csv(point, file.path(out_dir, "point_estimates.csv"), row.names = FALSE)
saveRDS(summ, file.path(out_dir, "posterior_summary.rds"))
write.csv(summ, file.path(out_dir, "posterior_summary.csv"), row.names = FALSE)
saveRDS(grab("pi"), file.path(out_dir, "posterior_int.rds"))
cat("Saved results to", out_dir, "\n")
# =============================================================================
# 03_figures_rw.R
# Manuscript figures for the Monte Carlo experiment (run 01_simulation_rw.R
# first). Starting age 40. Every figure is saved to random_walk/Figures/
# simulation/ and to Manuscript/figures/.
#
#   mc_scenarios.pdf   one row per scenario (N = 10^4):
#                      A true density, B posterior of the mode with
#                      independent gamma priors (raw), C posterior of the
#                      mode with the RW2 prior, D point estimates across
#                      replications (box plots)
#   mc_mae.pdf         mean absolute error by population size (log scale)
#   mc_bias.pdf        bias by population size
#   mc_coverage.pdf    coverage and width of the 95% credible interval,
#                      raw and RW2 posteriors
# =============================================================================
code_dir = Sys.getenv("MODE_RW_DIR", "~/Desktop/fertility/PDF_of_the_mode/Code/R/random_walk")
setwd(code_dir)
source("../sim_plot_utils.R")      # theme, truth, estimates, summaries, helpers
post_all = readRDS(file.path(in_dir, "sim_posteriors_all.rds"))$mean
fig_dir = file.path("Figures", "simulation")
ms_dir = Sys.getenv("MODE_MS_FIG_DIR", file.path("..", "..", "..", "Manuscript", "figures"))
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(ms_dir, recursive = TRUE, showWarnings = FALSE)
save_both = function(p, name, width, height) {
ggsave(file.path(fig_dir, name), p, width = width, height = height)
ggsave(file.path(ms_dir, name), p, width = width, height = height)
}
start = 40
show_N = 1e4
method_labels = c(rw2_mean = "RW2 posterior mean", rw2_median = "RW2 posterior median",
rw2_mode = "RW2 posterior mode", raw_mean = "Raw posterior mean",
raw_median = "Raw posterior median", raw_mode = "Raw posterior mode",
gompertz = "Gompertz", pspline = "P-spline", ddt = "DDT")
methods = c("rw2_mean", "rw2_median", "rw2_mode", "raw_mean", "gompertz", "pspline", "ddt")
cols = setNames(c("#0072B2", "#56B4E9", "#CC79A7", "#999999", "#E69F00", "#009E73",
"#D55E00"), method_labels[methods])
shapes = setNames(c(16, 1, 18, 3, 17, 15, 4), method_labels[methods])
# ---- Scenario figure --------------------------------------------------------
scenario_row_rw = function(sc, first) {
tm = data.frame(x = true_modes_sc(sc, start))
op = data.frame(x = other_peaks_sc(sc, start))
pm = post_all[post_all$scenario == sc & post_all$N == show_N &
post_all$start_age == start, ]
ek = est[est$scenario == sc & est$N == show_N & est$start_age == start &
est$method %in% methods & is.finite(est$estimate), ]
# common age window for B, C, D
a = pm$age[pm$prob >= 0.001]
win = c(min(a, floor(min(ek$estimate))) - 1, max(a + 1, ceiling(max(ek$estimate))) + 1)
dens = tr$truth[[sc]]$density
dens = dens[dens$age >= start & dens$age <= 105, ]
pA = ggplot(dens, aes(age, f)) +
annotate("rect", xmin = win[1], xmax = win[2], ymin = -Inf, ymax = Inf,
fill = "grey85", alpha = 0.5) +
geom_line(linewidth = 0.6) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
geom_vline(data = op, aes(xintercept = x), linetype = 3, linewidth = 0.3,
colour = "grey40") +
labs(x = NULL, y = "Density", subtitle = scen_labels[sc])
post_panel = function(fam, title) {
d = pm[pm$family == fam & pm$age + 0.5 >= win[1] & pm$age + 0.5 <= win[2], ]
ggplot(d, aes(age + 0.5, prob)) +
geom_col(fill = if (fam == "rw2") "#0072B2" else "#999999", width = 0.9) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
coord_cartesian(xlim = win) +
labs(x = NULL, y = "P(mode = x | data)", subtitle = if (first) title else NULL)
}
pB = post_panel("raw", "Raw posterior")
pC = post_panel("rw2", "RW2 posterior")
ek$method_lab = factor(method_labels[ek$method], levels = method_labels[methods])
pD = ggplot(ek, aes(estimate, method_lab, colour = method_lab, shape = method_lab)) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
geom_jitter(height = 0.2, width = 0, size = 0.8, alpha = 0.4) +
geom_boxplot(aes(group = method_lab), fill = NA, colour = "grey20",
outlier.shape = NA, width = 0.5, linewidth = 0.3) +
scale_colour_manual(values = cols, guide = "none") +
scale_shape_manual(values = shapes, guide = "none") +
scale_y_discrete(limits = rev(levels(ek$method_lab))) +
coord_cartesian(xlim = win) +
labs(x = NULL, y = NULL, subtitle = if (first) "Point estimates" else NULL)
list(pA, pB, pC, pD)
}
scs = tr$scenarios$scenario
plots = unlist(lapply(seq_along(scs), function(k) scenario_row_rw(scs[k], k == 1)),
recursive = FALSE)
fig = wrap_plots(plots, ncol = 4, widths = c(1, 1, 1, 1.3)) +
plot_annotation(
tag_levels = list(c("A", "B", "C", "D", rep("", 4 * (length(scs) - 1)))),
caption = sprintf(paste0("%s, starting age %d, %d replications. A: true density ",
"(shaded: ages shown in B-D). B, C: posterior of the mode averaged ",
"over replications.\nD: point estimates across replications. ",
"Dashed line: true mode; dotted line in A: secondary peak. ",
"Age at death on the horizontal axes."),
fmt_N(show_N), start, tr$settings$n_rep),
theme = theme(plot.caption = element_text(hjust = 0)))
save_both(fig, "mc_scenarios.pdf", 13, 2.7 * length(scs) + 0.8)
# ---- Errors by population size ----------------------------------------------
save_both(error_plot_by_N("mae", "Mean absolute error (years)", methods, cols, shapes,
start) + scale_y_log10(),
"mc_mae.pdf", 11, 4)
save_both(error_plot_by_N("bias", "Bias (years)", methods[methods != "gompertz"],
cols, shapes, start) +
labs(caption = sprintf("Starting age %d. Gompertz not shown (bias of 3 to 7 years with a secondary peak).", start)),
"mc_bias.pdf", 11, 4)
# ---- Coverage and width of the 95% credible interval ------------------------
fam_lab = c(raw_mean = "Raw posterior", rw2_mean = "RW2 posterior")
cv = summ[summ$method %in% names(fam_lab) & summ$start_age == start, ]
cv$fam = factor(fam_lab[cv$method], levels = fam_lab)
cv$scen_lab = factor(short_labels[cv$scenario], levels = short_labels)
base = function(var) {
ggplot(cv, aes(N, .data[[var]], colour = fam, shape = fam)) +
geom_line(linewidth = 0.5) +
geom_point(size = 2) +
facet_wrap(~ scen_lab, nrow = 1) +
scale_x_log10(breaks = sort(unique(cv$N)),
labels = function(x) parse(text = paste0("10^", log10(x)))) +
scale_colour_manual(values = setNames(c("#999999", "#0072B2"), fam_lab), name = NULL) +
scale_shape_manual(values = setNames(c(3, 16), fam_lab), name = NULL)
}
p1 = base("coverage") +
geom_hline(yintercept = 0.95, linetype = 2, colour = "grey50", linewidth = 0.3) +
coord_cartesian(ylim = c(min(0.8, min(cv$coverage)), 1)) +
labs(x = NULL, y = "Coverage")
p2 = base("mean_width") +
scale_y_log10() +
labs(x = "Population size N", y = "Width (years)")
save_both(p1 / p2 + plot_layout(guides = "collect") &
theme(legend.position = "bottom"),
"mc_coverage.pdf", 11, 6)
cat("Figures saved to", fig_dir, "and", ms_dir, "\n")
# =============================================================================
# 04_figures_empirical.R
# Manuscript figures and tables for the empirical application (run
# 02_empirical_rw.R first). Every figure is saved to random_walk/Figures/
# empirical/ and to Manuscript/figures/.
#
#   emp_trends.pdf             modal age at death by year, country and sex,
#                              starting age 50: RW2 posterior mean with 95%
#                              interval, Gompertz, P-spline, DDT
#   emp_start_age.pdf          change in each method's estimate when the
#                              starting age moves from 50 to 60 and to 70
#   emp_start_age_female.pdf,  estimates by year at the three starting ages,
#   emp_start_age_male.pdf     one row per method
# Results/empirical/
#   start_age_consistency.csv  mean and mean absolute change by method,
#                              comparison and country
# =============================================================================
code_dir = Sys.getenv("MODE_RW_DIR", "~/Desktop/fertility/PDF_of_the_mode/Code/R/random_walk")
setwd(code_dir)
library(ggplot2)
in_dir = file.path("Results", "empirical")
fig_dir = file.path("Figures", "empirical")
ms_dir = Sys.getenv("MODE_MS_FIG_DIR", file.path("..", "..", "..", "Manuscript", "figures"))
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(ms_dir, recursive = TRUE, showWarnings = FALSE)
save_both = function(p, name, width, height) {
ggsave(file.path(fig_dir, name), p, width = width, height = height)
ggsave(file.path(ms_dir, name), p, width = width, height = height)
}
pe = readRDS(file.path(in_dir, "point_estimates.rds"))
method_labels = c(rw2_mean = "RW2 posterior mean", rw2_median = "RW2 posterior median",
rw2_mode = "RW2 posterior mode", gompertz = "Gompertz",
pspline = "P-spline", ddt = "DDT")
cols = setNames(c("#0072B2", "#56B4E9", "#CC79A7", "#E69F00", "#009E73", "#D55E00"),
method_labels)
shapes = setNames(c(16, 1, 18, 17, 15, 4), method_labels)
pe$method_lab = factor(method_labels[pe$method], levels = method_labels)
theme_set(theme_minimal(base_size = 10) +
theme(panel.grid.minor = element_blank(),
panel.grid.major = element_line(colour = "grey92", linewidth = 0.3),
strip.text = element_text(face = "bold", hjust = 0),
legend.position = "bottom"))
# ---- Trends at starting age 50 ----------------------------------------------
base_start = 50
tm = c("rw2_mean", "gompertz", "pspline", "ddt")
d = pe[pe$start_age == base_start & pe$method %in% tm, ]
band = d[d$method == "rw2_mean", ]
p = ggplot(d, aes(year, estimate, colour = method_lab)) +
geom_ribbon(data = band, aes(ymin = lower, ymax = upper), fill = "#0072B2",
alpha = 0.2, colour = NA) +
geom_line(linewidth = 0.4) +
facet_grid(sex ~ country) +
scale_colour_manual(values = cols[method_labels[tm]], name = NULL) +
labs(x = "Year", y = "Modal age at death",
caption = sprintf(paste("Starting age %d. Shaded: 95%% credible interval of the",
"RW2 posterior."), base_start))
save_both(p, "emp_trends.pdf", 12, 6)
# ---- Consistency across starting ages ---------------------------------------
key = paste(pe$country, pe$sex, pe$year, pe$method)
ref = pe[pe$start_age == base_start, ]
pe$ref = ref$estimate[match(key, paste(ref$country, ref$sex, ref$year, ref$method))]
dd = pe[pe$start_age != base_start, ]
dd$change = dd$estimate - dd$ref
dd$comparison = factor(sprintf("%d vs %d", dd$start_age, base_start),
levels = sprintf("%d vs %d", sort(unique(dd$start_age)), base_start))
p = ggplot(dd, aes(method_lab, change, fill = comparison)) +
geom_hline(yintercept = 0, colour = "grey50", linewidth = 0.3) +
geom_boxplot(outlier.size = 0.4, linewidth = 0.3,
position = position_dodge(width = 0.75), width = 0.65) +
facet_wrap(~ country, nrow = 2) +
scale_fill_manual(values = c("#BBBBBB", "#555555"), name = "Starting age") +
labs(x = NULL, y = "Change in the estimated mode (years)",
caption = sprintf(paste("Estimate at the later starting age minus the estimate",
"at %d; all years and both sexes."), base_start)) +
theme(axis.text.x = element_text(angle = 30, hjust = 1))
save_both(p, "emp_start_age.pdf", 12, 7)
for (sx in c("Female", "Male")) {
d = pe[pe$sex == sx, ]
d$start_lab = factor(paste("Starting age", d$start_age))
p = ggplot(d, aes(year, estimate, colour = start_lab)) +
geom_line(linewidth = 0.35) +
facet_grid(method_lab ~ country) +
scale_colour_manual(values = c("#0072B2", "#E69F00", "#D55E00"), name = NULL) +
labs(x = "Year", y = "Modal age at death", caption = paste0(sx, "s.")) +
theme(strip.text.y = element_text(angle = 0, hjust = 0))
save_both(p, sprintf("emp_start_age_%s.pdf", tolower(sx)), 12, 10)
}
# ---- Table ------------------------------------------------------------------
agg = function(z) {
data.frame(n = sum(is.finite(z$change)),
mean_change = mean(z$change, na.rm = TRUE),
mean_abs_change = mean(abs(z$change), na.rm = TRUE),
max_abs_change = max(abs(z$change), na.rm = TRUE))
}
g = split(dd, list(dd$method, dd$comparison), drop = TRUE)
tab_all = do.call(rbind, lapply(g, function(z) {
data.frame(method = z$method[1], comparison = z$comparison[1], country = "All", agg(z))
}))
g = split(dd, list(dd$method, dd$comparison, dd$country), drop = TRUE)
tab_c = do.call(rbind, lapply(g, function(z) {
data.frame(method = z$method[1], comparison = z$comparison[1], country = z$country[1],
agg(z))
}))
tab = rbind(tab_all, tab_c)
tab$method = factor(tab$method, levels = names(method_labels))
tab = tab[order(tab$country != "All", tab$country, tab$comparison, tab$method), ]
write.csv(tab, file.path(in_dir, "start_age_consistency.csv"), row.names = FALSE)
print(tab_all[order(tab_all$comparison, tab_all$method), ], row.names = FALSE)
cat("Figures saved to", fig_dir, "and", ms_dir, "\n")
