# Load required packages
library(dplyr)
library(parallel)
# Source required functions
source("mode_exact.R")
# Define the custom `rgompertz` function
rgompertz <- function(n, M = 1, b = 1) {
a <- b / exp(M * b)
u <- runif(n)
x <- log(1 - b * log(1 - u) / a) / b
return(x)
}
# Set parameter values
M_0 <- seq(80, 90, 5)
b <- c(0.1, 0.12)
n <- c(2000, 5000, 10000)
combinations <- expand.grid(M_0 = M_0, b = b, n = n)
names(combinations) <- c("M", "b", "n")
theta <- split(combinations, seq(nrow(combinations)))
N <- 3333
# Initialize parallel cluster
num_cores <- detectCores() - 1
cl <- makeCluster(num_cores)
# Export necessary functions and data to each worker
clusterExport(cl, c("rgompertz", "mode_dist_gauss", "theta", "N"))
# Set the working directory and clean the environment
setwd("/Users/scp93/Desktop/PhD/codes/mode_dist/")
rm(list = ls())
# Load required packages
library(dplyr)
library(parallel)
# Source required functions
source("mode_exact.R")
# Define the custom `rgompertz` function
rgompertz <- function(n, M = 1, b = 1) {
a <- b / exp(M * b)
u <- runif(n)
x <- log(1 - b * log(1 - u) / a) / b
return(x)
}
# Set parameter values
M_0 <- seq(80, 90, 5)
b <- c(0.1, 0.12)
n <- c(2000, 5000, 10000)
combinations <- expand.grid(M_0 = M_0, b = b, n = n)
names(combinations) <- c("M", "b", "n")
theta <- split(combinations, seq(nrow(combinations)))
N <- 3333
# Initialize parallel cluster
num_cores <- detectCores() - 1
cl <- makeCluster(num_cores)
# Export necessary functions and data to each worker
clusterExport(cl, c("rgompertz", "mode_dist_gauss", "theta", "N"))
# Define the parallel task function
parallel_task <- function(theta_0) {
# Extract parameters only once
M_val <- theta_0$M
b_val <- theta_0$b
n_val <- theta_0$n
# Preallocate matrix for the results of N simulations
result_matrix <- matrix(NA, nrow = N, ncol = 8)
colnames(result_matrix) <- c("M", "b", "n", "mean", "mode", "sd", "IC_L", "IC_U")
for (i in seq_len(N)) {
# Generate data
x.real <- rgompertz(n = n_val, b = b_val, M = M_val)
x.floor <- floor(x.real)
# Get age and Dx in one step using `table`
age_Dx <- table(x.floor)
age <- as.numeric(names(age_Dx))
Dx <- as.vector(age_Dx)
# Calculate mode estimates
mode_gauss <- mode_dist_gauss(dx = Dx, x = age)
# Calculate the mean of the distribution
mean_mode = sum(mode_estim$mode * mode_estim$prob, na.rm = T)
# Calculate the median of the distribution
mode_mode = mean(mode_estim$mode[which.max(mode_estim$prob)], na.rm = T)
# Calculate the variance
variance <- sum((mode_estim$mode - mean_mode)^2 * mode_estim$prob, na.rm = T)
# Calculate the standard deviation
sd_value <- sqrt(variance)
# Store values in result_matrix
result_matrix[i, ] <- c(M_val, b_val, n_val,
mean_mode, mode_mode,
sd_value, mode_estim$quantile_2_5[1],
mode_estim$quantile_97_5[1])
}
return(result_matrix)
}
# Run the tasks in parallel over `theta`
results <- parLapply(cl, theta, parallel_task)
