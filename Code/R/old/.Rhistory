# Ensure max_probabilities sums to a valid probability distribution
if (sum(max_probabilities) == 0) {
warning("Sum of max probabilities is zero; setting all probabilities to zero.")
probabilities <- rep(0, K)
} else {
probabilities <- max_probabilities / sum(max_probabilities)
}
df_mode <- data.frame(
mode = x,
prob = probabilities,
cum_prob = cumsum(probabilities)
)
df_mode = df_mode[df_mode$prob>0,]
# Identify the 2.5% quantile
quantile_2_5 <- df_mode$mode[which.min(abs(df_mode$cum_prob - 0.025))]
# Identify the 97.5% quantile
quantile_97_5 <- df_mode$mode[which.min(abs(df_mode$cum_prob - 0.975))]
# Create a data frame with results
df_mode <- data.frame(
mode = x,
prob = probabilities,
cum_prob = cumsum(probabilities),
quantile_2_5,
quantile_97_5
)
return(df_mode)
}
mode_summary <- read.csv("~/Desktop/PhD/codes/mode_dist/data/mode_summary.txt", sep="")
library(ggplot2)
mode_summary %>%
filter(Sex == "Female") %>%
ggplot(aes(x = Year, color = Sex)) +
# Confidence interval shaded area with custom color and no border
geom_ribbon(aes(ymin = quantile_2_5, ymax = quantile_97_5, fill = Sex), alpha = 0.3, color = NA) +
# Line for the mean
geom_line(aes(y = mean, linetype = "Estimation"), size = .5) +
# Line for the median
# geom_line(aes(y = median, linetype = "Median"), size = .5) +
# Line for the mode
