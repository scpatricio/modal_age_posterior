# Appendix tables with the full Monte Carlo results (Appendix E). Run
# 01_simulation.R first. Tables are saved to results/simulation/tables/ and
# to the manuscript (see utils.R).
#
#   app_mc_mae.tex        mean absolute error, all methods
#   app_mc_bias.tex       bias, all methods
#   app_mc_sd.tex         standard deviation of the estimates, all methods
#   app_mc_coverage.tex   coverage and width of the 95% intervals: credible
#                         (raw, RW2) and bootstrap (Gompertz, P-spline, DDT)
# =============================================================================
if (!file.exists("utils.R")) stop("Run this script with the Code folder as working directory (open Code.Rproj).")
source("utils.R")
in_dir = file.path("results", "simulation")
summ = read.csv(file.path(in_dir, "sim_summary.csv"))
tr = readRDS(file.path(in_dir, "sim_truth.rds"))
start = 40
summ = summ[summ$start_age == start, ]
methods = c(rw2_mean = "Mean", rw2_median = "Median", rw2_mode = "Mode",
raw_mean = "Mean", raw_median = "Median", raw_mode = "Mode",
gompertz = "Gompertz", pspline = "P-spline", ddt = "DDT")
scen = tr$scenarios
scen_lab = ifelse(scen$w == 1, "(a) unimodal",
sprintf("(%s) %.0f\\%% earlier", scen$scenario, 100 * (1 - scen$w)))
names(scen_lab) = scen$scenario
N_lab = function(N) sprintf("$10^%d$", round(log10(N)))
fmt = function(x, digits) {
out = formatC(x, format = "f", digits = digits)
out = ifelse(substr(out, 1, 1) == "-", paste0("$-$", substring(out, 2)), out)
ifelse(is.finite(x), out, "--")
}
save_tab = function(lines, name) save_table(lines, name, file.path("simulation", "tables"))
method_table = function(var, caption, label, digits = 4) {
head = c("\\begin{table}[htb!]",
"\\centering",
sprintf("\\caption{%s}", caption),
sprintf("\\label{%s}", label),
"\\scriptsize",
"\\setlength{\\tabcolsep}{4pt}",
"\\begin{tabular}{llrrrrrrrrr}",
"\\hline",
" & & \\multicolumn{3}{c}{RW2 posterior} & \\multicolumn{3}{c}{Raw posterior} & & & \\\\",
"Scenario & $N$ & Mean & Median & Mode & Mean & Median & Mode & Gompertz & P-spline & DDT \\\\",
"\\hline")
body = c()
for (sc in scen$scenario) {
for (N in sort(unique(summ$N))) {
z = summ[summ$scenario == sc & summ$N == N, ]
v = sapply(names(methods), function(m) z[[var]][z$method == m])
first = N == min(summ$N)
body = c(body, paste0(if (first) scen_lab[sc] else "", " & ", N_lab(N), " & ",
paste(fmt(v, digits), collapse = " & "), " \\\\"))
}
if (sc != tail(scen$scenario, 1)) body = c(body, "")
}
c(head, body, "\\hline", "\\end{tabular}", "\\end{table}")
}
# turn the empty separator lines into extra space after the preceding row
tidy = function(lines) {
out = c()
for (ln in lines) {
if (ln == "" && length(out) > 0) {
out[length(out)] = sub("\\\\\\\\$", "\\\\\\\\[2pt]", out[length(out)])
} else {
out = c(out, ln)
}
out
}
cap_note = sprintf("Starting age %d, %d replications, true mode 90.", start, tr$settings$n_rep)
save_tab(tidy(method_table("mae", paste("Simulation study: mean absolute error (years) of the estimated modal age.", cap_note), "tab:app_mae")),
"app_mc_mae.tex")
save_tab(tidy(method_table("bias", paste("Simulation study: bias (years) of the estimated modal age.", cap_note), "tab:app_bias")),
"app_mc_bias.tex")
save_tab(tidy(method_table("sd", paste("Simulation study: standard deviation (years) of the estimated modal age across replications.", cap_note), "tab:app_sd")),
"app_mc_sd.tex")
# coverage and width: credible intervals (raw, RW2) and bootstrap intervals
boot_file = file.path(in_dir, "sim_bootstrap_summary.csv")
bs = if (file.exists(boot_file)) read.csv(boot_file) else summ[0, ]
cmeth = c("raw_mean", "rw2_mean", "gompertz", "pspline", "ddt")
clab = c("Raw", "RW2", "Gomp.", "P-spl.", "DDT")
head = c("\\begin{table}[htb!]",
"\\centering",
sprintf("\\caption{Simulation study: coverage and mean width (years) of the 95\\%% intervals for the modal age: credible intervals of the raw and RW2 posteriors (posterior of $\\tilde{M}$) and bootstrap percentile intervals of the Gompertz, P-spline and DDT estimators. %s}", cap_note),
"\\label{tab:app_coverage}",
"\\footnotesize",
"\\setlength{\\tabcolsep}{4pt}",
"\\begin{tabular}{ll*{10}{r}}",
"\\hline",
" & & \\multicolumn{5}{c}{Coverage} & \\multicolumn{5}{c}{Width} \\\\",
paste0("Scenario & $N$ & ", paste(c(clab, clab), collapse = " & "), " \\\\"),
"\\hline")
body = c()
for (sc in scen$scenario) {
for (N in sort(unique(summ$N))) {
z = rbind(summ[summ$scenario == sc & summ$N == N & summ$method %in% c("raw_mean", "rw2_mean"),
c("method", "coverage", "mean_width")],
bs[bs$scenario == sc & bs$N == N, c("method", "coverage", "mean_width")])
g = function(m, v) {
x = as.numeric(z[[v]][z$method == m])
if (length(x) == 0) NA_real_ else x[1]
}
first = N == min(summ$N)
body = c(body, paste0(if (first) scen_lab[sc] else "", " & ", N_lab(N), " & ",
paste(fmt(vapply(cmeth, g, numeric(1), v = "coverage"), 4), collapse = " & "), " & ",
paste(fmt(vapply(cmeth, g, numeric(1), v = "mean_width"), 4), collapse = " & "),
" \\\\"))
}
if (sc != tail(scen$scenario, 1)) body = c(body, "")
}
save_tab(tidy(c(head, body, "\\hline", "\\end{tabular}", "\\end{table}")), "app_mc_coverage.tex")
cat("Tables saved to results/simulation/tables\n")
# =============================================================================
# 02_figures_simulation.R
# Figures of the Monte Carlo experiment (Section 3 and Appendix E). Run
# 01_simulation.R first. Figures are saved to figures/simulation/ and to the
# manuscript (see utils.R).
#
#   mc_scenarios.pdf   one row per scenario (N = 10^4):
#                      A true density, B post. of the mode with
#                      independent gamma priors (raw), C post. of the
#                      mode with the RW2 prior, D point estimates across
#                      replications (box plots)
#   mc_mae.pdf         mean absolute error by population size (log scale)
#   mc_bias.pdf        bias by population size (Appendix E)
#   mc_coverage.pdf    coverage and width of the 95% intervals: credible
#                      intervals (raw and RW2 posteriors) and bootstrap
#                      intervals (Gompertz, P-spline, DDT)
# =============================================================================
if (!file.exists("utils.R")) stop("Run this script with the Code folder as working directory (open Code.Rproj).")
source("utils.R")
source("plot_utils.R")      # theme, truth, estimates, summaries, helpers
post_all = readRDS(file.path(in_dir, "sim_posteriors.rds"))$mean
save_both = function(p, name, height) save_figure(p, name, "simulation", height)
start = 40
show_N = 1e4
method_labels = c(rw2_mean = "RW2 post. mean", rw2_median = "RW2 post. median",
rw2_mode = "RW2 post. mode", raw_mean = "Raw post. mean",
raw_median = "Raw post. median", raw_mode = "Raw post. mode",
gompertz = "Gompertz", pspline = "P-spline", ddt = "DDT")
methods = c("rw2_mean", "rw2_median", "rw2_mode", "raw_mean", "gompertz", "pspline", "ddt")
cols = setNames(c("#0072B2", "#56B4E9", "#CC79A7", "#999999", "#E69F00", "#009E73",
"#D55E00"), method_labels[methods])
shapes = setNames(c(16, 1, 18, 3, 17, 15, 4), method_labels[methods])
# ---- Scenario figure --------------------------------------------------------
scenario_row_rw = function(sc, first) {
tm = data.frame(x = true_modes_sc(sc, start))
op = data.frame(x = other_peaks_sc(sc, start))
pm = post_all[post_all$scenario == sc & post_all$N == show_N &
post_all$start_age == start, ]
ek = est[est$scenario == sc & est$N == show_N & est$start_age == start &
est$method %in% methods & is.finite(est$estimate), ]
# common age window for B, C, D
a = pm$age[pm$prob >= 0.001]
win = c(min(a, floor(min(ek$estimate))) - 1, max(a + 1, ceiling(max(ek$estimate))) + 1)
dens = tr$truth[[sc]]$density
dens = dens[dens$age >= start & dens$age <= 105, ]
pA = ggplot(dens, aes(age, f)) +
annotate("rect", xmin = win[1], xmax = win[2], ymin = -Inf, ymax = Inf,
fill = "grey85", alpha = 0.5) +
geom_line(linewidth = 0.6) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
geom_vline(data = op, aes(xintercept = x), linetype = 3, linewidth = 0.3,
colour = "grey40") +
labs(x = NULL, y = "Density", subtitle = scen_labels[sc])
post_panel = function(fam, title) {
d = pm[pm$family == fam & pm$age + 0.5 >= win[1] & pm$age + 0.5 <= win[2], ]
ggplot(d, aes(age + 0.5, prob)) +
geom_col(fill = if (fam == "rw2") "#0072B2" else "#999999", width = 0.9) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
scale_x_continuous(breaks = scales::breaks_pretty(n = 3)) +
coord_cartesian(xlim = win) +
labs(x = NULL, y = "P(mode = x | data)", subtitle = if (first) title else NULL)
}
pB = post_panel("raw", "Raw posterior")
pC = post_panel("rw2", "RW2 posterior")
ek$method_lab = factor(method_labels[ek$method], levels = method_labels[methods])
pD = ggplot(ek, aes(estimate, method_lab, colour = method_lab, shape = method_lab)) +
geom_vline(data = tm, aes(xintercept = x), linetype = 2, linewidth = 0.3) +
geom_jitter(height = 0.2, width = 0, size = 0.8, alpha = 0.4) +
geom_boxplot(aes(group = method_lab), fill = NA, colour = "grey20",
outlier.shape = NA, width = 0.5, linewidth = 0.3) +
scale_colour_manual(values = cols, guide = "none") +
scale_shape_manual(values = shapes, guide = "none") +
scale_y_discrete(limits = rev(levels(ek$method_lab))) +
scale_x_continuous(breaks = scales::breaks_pretty(n = 3)) +
coord_cartesian(xlim = win) +
labs(x = NULL, y = NULL, subtitle = if (first) "Point estimates" else NULL)
list(pA, pB, pC, pD)
}
scs = tr$scenarios$scenario
plots = unlist(lapply(seq_along(scs), function(k) scenario_row_rw(scs[k], k == 1)),
recursive = FALSE)
fig = wrap_plots(plots, ncol = 4, widths = c(1, 1, 1, 1.3)) +
plot_annotation(
tag_levels = list(c("A", "B", "C", "D", rep("", 4 * (length(scs) - 1)))))
save_both(fig, "mc_scenarios.pdf", 2.9 * length(scs) + 1)
# ---- Errors by population size ----------------------------------------------
save_both(error_plot_by_N("mae", "Mean absolute error (years)", methods, cols, shapes,
start) + scale_y_log10(),
"mc_mae.pdf", 5)
save_both(error_plot_by_N("bias", "Bias (years)", methods[methods != "gompertz"],
cols, shapes, start),
"mc_bias.pdf", 5)
# ---- Coverage and width of the 95% intervals --------------------------------
# Credible intervals of the raw and RW2 posteriors (01_simulation.R) and
# bootstrap percentile intervals of the benchmarks (01b_simulation_bootstrap.R)
fam_lab = c(raw_mean = "Raw posterior", rw2_mean = "RW2 posterior",
gompertz = "Gompertz (bootstrap)", pspline = "P-spline (bootstrap)",
ddt = "DDT (bootstrap)")
fam_col = setNames(c("#999999", "#0072B2", "#E69F00", "#009E73", "#D55E00"), fam_lab)
fam_shape = setNames(c(3, 16, 17, 15, 4), fam_lab)
fam_lty = setNames(c(1, 1, 2, 2, 2), fam_lab)
cv = summ[summ$method %in% c("raw_mean", "rw2_mean") & summ$start_age == start,
c("scenario", "N", "method", "coverage", "mean_width")]
boot_file = file.path(in_dir, "sim_bootstrap_summary.csv")
if (file.exists(boot_file)) {
bs = read.csv(boot_file)
cv = rbind(cv, bs[bs$start_age == start, c("scenario", "N", "method", "coverage", "mean_width")])
} else {
message("sim_bootstrap_summary.csv not found: run 01b_simulation_bootstrap.R for the bootstrap intervals")
}
cv$fam = factor(fam_lab[cv$method], levels = fam_lab)
cv$scen_lab = factor(short_labels[cv$scenario], levels = short_labels)
base = function(var) {
ggplot(cv, aes(N, .data[[var]], colour = fam, shape = fam, linetype = fam)) +
geom_line(linewidth = 0.5) +
geom_point(size = 2) +
facet_wrap(~ scen_lab, nrow = 1) +
scale_x_log10(breaks = sort(unique(cv$N)),
labels = function(x) parse(text = paste0("10^", log10(x)))) +
scale_colour_manual(values = fam_col, name = NULL) +
scale_shape_manual(values = fam_shape, name = NULL) +
scale_linetype_manual(values = fam_lty, name = NULL)
}
p1 = base("coverage") +
geom_hline(yintercept = 0.95, linetype = 3, colour = "grey40", linewidth = 0.3) +
scale_y_continuous(limits = c(0, 1)) +
labs(x = NULL, y = "Coverage")
p2 = base("mean_width") +
scale_y_log10() +
labs(x = "Population size N", y = "Width (years)")
save_both(p1 / p2 + plot_layout(guides = "collect") &
theme(legend.position = "bottom"),
"mc_coverage.pdf", 7.5)
cat("Figures saved to figures/simulation\n")
# =============================================================================
# 05_figures_empirical.R
# Figures and tables of the empirical application (Section 4, Table 1 and
# Appendix F). Women in Denmark, France, Japan and Sweden. Run 04_empirical.R
# first. Figures are saved to figures/empirical/, tables to
# results/empirical/, and both to the manuscript (see utils.R).
#
#   emp_trends.pdf             modal age at death by year and country,
#                              starting age 40: RW2 post. mean with 95%
#                              interval, Gompertz, P-spline, DDT
#   emp_start_age.pdf          Denmark: estimates by year for each method
#                              (one panel per method), one line per starting
#                              age (40, 50, 60, 70)
#   emp_start_age_all.pdf      the same for the four countries (Appendix F)
#   emp_start_age.tex          Table 1: change in each method's estimate when
#                              the starting age moves from 40 to 50, 60, 70
#   start_age_consistency.csv  mean, mean absolute and largest absolute
#                              change by method, comparison and country
# =============================================================================
if (!file.exists("utils.R")) stop("Run this script with the Code folder as working directory (open Code.Rproj).")
source("utils.R")
library(ggplot2)
in_dir = file.path("results", "empirical")
save_both = function(p, name, height) save_figure(p, name, "empirical", height)
pe = readRDS(file.path(in_dir, "point_estimates.rds"))
base_start = min(pe$start_age)           # reference starting age (40)
show_country = "Denmark"                 # country of the main starting-age figure
method_labels = c(rw2_mean = "RW2 post. mean", rw2_median = "RW2 post. median",
rw2_mode = "RW2 post. mode", gompertz = "Gompertz",
pspline = "P-spline", ddt = "DDT")
cols = setNames(c("#0072B2", "#56B4E9", "#CC79A7", "#E69F00", "#009E73", "#D55E00"),
method_labels)
pe$method_lab = factor(method_labels[pe$method], levels = method_labels)
start_levels = paste("Starting age", sort(unique(pe$start_age)))
pe$start_lab = factor(paste("Starting age", pe$start_age), levels = start_levels)
start_cols = setNames(c("#0072B2", "#E69F00", "#009E73", "#D55E00")[seq_along(start_levels)],
start_levels)
theme_set(theme_mode())
# ---- Trends at the reference starting age -----------------------------------
tm = c("rw2_mean", "gompertz", "pspline", "ddt")
d = pe[pe$start_age == base_start & pe$method %in% tm, ]
band = d[d$method == "rw2_mean", ]
p = ggplot(d, aes(year, estimate, colour = method_lab)) +
geom_ribbon(data = band, aes(ymin = lower, ymax = upper), fill = "#0072B2",
alpha = 0.2, colour = NA) +
geom_line(linewidth = 0.4) +
facet_wrap(~ country, nrow = 1) +
scale_colour_manual(values = cols[method_labels[tm]], name = NULL) +
labs(x = "Year", y = "Modal age at death")
save_both(p, "emp_trends.pdf", 4.5)
# ---- Estimates at the four starting ages ------------------------------------
start_plot = function(d, facet) {
ggplot(d, aes(year, estimate, colour = start_lab)) +
geom_line(linewidth = 0.35) +
facet +
scale_colour_manual(values = start_cols, name = NULL) +
labs(x = "Year", y = "Modal age at death")
}
d = pe[pe$country == show_country, ]
p = start_plot(d, facet_wrap(~ method_lab, nrow = 2))
save_both(p, "emp_start_age.pdf", 7)
p = start_plot(pe, facet_grid(method_lab ~ country)) +
theme(strip.text.y = element_text(angle = -90, hjust = 0.5))
save_both(p, "emp_start_age_all.pdf", 12)
cat("Figures saved to figures/empirical\n")
# ---- Changes relative to the reference starting age -------------------------
key = paste(pe$country, pe$sex, pe$year, pe$method)
ref = pe[pe$start_age == base_start, ]
pe$ref = ref$estimate[match(key, paste(ref$country, ref$sex, ref$year, ref$method))]
dd = pe[pe$start_age != base_start, ]
dd$change = dd$estimate - dd$ref
dd$comparison = factor(sprintf("%d vs %d", dd$start_age, base_start),
levels = sprintf("%d vs %d", sort(unique(dd$start_age)), base_start))
agg = function(z) {
data.frame(n = sum(is.finite(z$change)),
mean_change = mean(z$change, na.rm = TRUE),
mean_abs_change = mean(abs(z$change), na.rm = TRUE),
max_abs_change = max(abs(z$change), na.rm = TRUE))
}
g = split(dd, list(dd$method, dd$comparison), drop = TRUE)
tab_all = do.call(rbind, lapply(g, function(z) {
data.frame(method = z$method[1], comparison = z$comparison[1], country = "All", agg(z))
}))
g = split(dd, list(dd$method, dd$comparison, dd$country), drop = TRUE)
tab_c = do.call(rbind, lapply(g, function(z) {
data.frame(method = z$method[1], comparison = z$comparison[1], country = z$country[1],
agg(z))
}))
tab = rbind(tab_all, tab_c)
tab$method = factor(tab$method, levels = names(method_labels))
tab = tab[order(tab$country != "All", tab$country, tab$comparison, tab$method), ]
write.csv(tab, file.path(in_dir, "start_age_consistency.csv"), row.names = FALSE)
print(tab_all[order(tab_all$comparison, tab_all$method), ], row.names = FALSE)
# ---- LaTeX table (Table 1 of the manuscript) --------------------------------
f2 = function(x, digits = 4) {
out = formatC(x, format = "f", digits = digits)
out = ifelse(abs(x) < 0.5 * 10^-digits, formatC(0, format = "f", digits = digits), out)
ifelse(substr(out, 1, 1) == "-", paste0("$-$", substring(out, 2)), out)
}
row_methods = c("rw2_mean", "rw2_median", "rw2_mode", "pspline", "gompertz", "ddt")
comps = levels(dd$comparison)
rows = sapply(row_methods, function(m) {
v = unlist(lapply(comps, function(cp) {
z = tab_all[tab_all$method == m & tab_all$comparison == cp, ]
c(z$mean_abs_change, z$max_abs_change)
}))
paste0(method_labels[m], " & ", paste(f2(v), collapse = " & "), " \\\\")
})
n_pop = length(unique(paste(pe$country, pe$sex, pe$year)))
later = sort(unique(dd$start_age))
tab = c("\\begin{table}[htb!]",
"\\centering",
sprintf(paste0("\\caption{Change in the estimated modal age at death when the starting age moves ",
"from %d to %s: mean absolute change and largest absolute change (years), ",
"women in %d countries, all years (%d population-years). ",
"DDT uses the rates at each age separately and does not depend on the starting age.}"),
base_start, paste0(paste(head(later, -1), collapse = ", "), " and ", tail(later, 1)),
length(unique(pe$country)), n_pop),
"\\label{tab:start_age}",
"\\small",
sprintf("\\begin{tabular}{l%s}", strrep("rr", length(comps))),
"\\hline",
paste0(" & ", paste(sprintf("\\multicolumn{2}{c}{%s}", comps), collapse = " & "), " \\\\"),
paste0("Method & ", paste(rep("Mean abs. & Max abs.", length(comps)), collapse = " & "),
" \\\\"),
"\\hline", rows, "\\hline", "\\end{tabular}", "\\end{table}")
save_table(tab, "emp_start_age.tex", "empirical")
cat("Table saved to results/empirical\n")
# =============================================================================
# 06_laplace_vs_mcmc.R
# Checks the Laplace approximation of the RW2 posterior against exact
# posterior sampling of the same model (Appendix D), for women in Denmark,
# France, Japan and Sweden in 1960 and 2019, starting age 50.
#
# Exact sampling: independence Metropolis-Hastings (rw_imh_cpp() in
# rw_core.cpp) with the Laplace mixture over the grid of lambda as proposal.
# The accept/reject step corrects any error of the approximation, so the
# chain targets the exact posterior of the model (Poisson likelihood, RW2
# prior, flat prior on the grid of log10 lambda). Its acceptance rate is a
# direct measure of the quality of the approximation (1 if it were exact).
#
# Outputs:
#   results/mcmc_check/laplace_vs_mcmc.csv   posterior summaries, both methods
#   results/mcmc_check/app_laplace_mcmc.tex  the same as a LaTeX table
#   figures/mcmc_check/app_laplace_mcmc.pdf  P(mode = x | data), both methods
# (table and figure also go to the manuscript, see utils.R). The numbers
# quoted in Appendix D are printed at the end.
# =============================================================================
if (!file.exists("utils.R")) stop("Run this script with the Code folder as working directory (open Code.Rproj).")
for (f in c("utils.R", "mode_posterior.R", "mode_posterior_rw.R")) source(f)
library(ggplot2)
if (!rw_use_cpp) stop("This check needs the C++ core (rw_core.cpp); see mode_posterior_rw.R.")
data_dir = "data"
start_age = 50
max_age = 110
S = 20000                       # Laplace draws
n_iter = 100000                 # Metropolis-Hastings iterations
log10_lambdas = seq(-1, 8, by = 0.25)
drop = 12
cases = data.frame(code = rep(names(hmd_countries), each = 2),
country = rep(unname(hmd_countries), each = 2),
sex = "Female",
year = rep(c(1960, 2019), length(hmd_countries)))
seed = 20261108
out_dir = file.path("results", "mcmc_check")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
hmd = do.call(rbind, lapply(unique(cases$code), load_country, data_dir = data_dir))
# life-table deaths from draws of the log rates (draws in rows); last column
# the open interval, as in mode_posterior_rw()
d_from_eta = function(eta) {
d = cbind(-expm1(-exp(eta)), 1)
l = rep(1, nrow(d))
for (i in 1:ncol(d)) {
qi = d[, i]
d[, i] = l * qi
l = l * (1 - qi)
}
d
}
# effective sample size of a chain (initial positive sequence estimator)
ess = function(x) {
n = length(x)
r = acf(x, lag.max = min(n - 1, 2000), plot = FALSE)$acf[-1]
k = which(r[seq(1, length(r) - 1, by = 2)] + r[seq(2, length(r), by = 2)] < 0)[1]
m = if (is.na(k)) length(r) else 2 * (k - 1)
n / (1 + 2 * sum(r[seq_len(m)]))
}
summ = list()
probs = list()
for (k in seq_len(nrow(cases))) {
cs = cases[k, ]
y = hmd[hmd$country == cs$country & hmd$sex == cs$sex & hmd$year == cs$year, ]
s = prep_schedule(y$age, y$deaths, y$exposure, start_age, max_age)
nc = length(s$age) - 1
D = s$deaths[1:nc]
E = s$exposure[1:nc]
set.seed(seed + k)
# Laplace approximation (the method used in the paper)
lap = mode_posterior_rw(y$age, y$deaths, y$exposure, start_age, max_age, S = S,
log10_lambdas = log10_lambdas)
# exact posterior: independence Metropolis-Hastings with the same proposal
g = rw_grid_cpp(D, E, 2L, log10_lambdas, drop)
w = exp(g$logml - max(g$logml))
w = w / sum(w)
ch = rw_imh_cpp(D, E, g$eta, g$L, g$log10_lambda, w, n_iter, 2L)
mc = posterior_summary(d_from_eta(ch$eta), s$age, start_age, n_iter, 0.95, 0.1, 0.5,
return_draws = TRUE)
ll_chain = g$log10_lambda[ch$cell + 1]
lab = sprintf("%s, %d", cs$country, cs$year)
for (meth in c("Laplace", "MCMC")) {
p = if (meth == "Laplace") lap else mc
summ[[paste(k, meth)]] = data.frame(cs, case = lab, method = meth,
mean = p$mean, median = p$median, q025 = p$q025, q975 = p$q975, map = p$map,
p_map = p$p_map,
log10_lambda = if (meth == "Laplace") lap$post_log10_lambda else mean(ll_chain),
acceptance = if (meth == "MCMC") ch$acceptance else NA,
ess_mode = if (meth == "MCMC") ess(mc$draws_cont) else NA)
probs[[paste(k, meth)]] = data.frame(case = lab, method = meth, age = p$post$age,
prob = p$post$prob)
}
cat(lab, ": acceptance", round(ch$acceptance, 3), "\n")
}
summ = do.call(rbind, summ)
probs = do.call(rbind, probs)
write.csv(summ, file.path(out_dir, "laplace_vs_mcmc.csv"), row.names = FALSE)
print(summ[, c("case", "method", "mean", "q025", "q975", "map", "p_map", "log10_lambda",
"acceptance", "ess_mode")], row.names = FALSE)
L = summ[summ$method == "Laplace", ]
M = summ[summ$method == "MCMC", ]
cat("\nLargest differences, Laplace vs MCMC:",
"\n  posterior mean of the mode:", max(abs(L$mean - M$mean)),
"\n  2.5% and 97.5% limits:", max(abs(L$q025 - M$q025)), max(abs(L$q975 - M$q975)),
"\n  probability of the most probable age:", max(abs(L$p_map - M$p_map)),
"\n  same most probable age in all cases:", all(L$map == M$map),
"\n  posterior mean of log10 lambda:", max(abs(L$log10_lambda - M$log10_lambda)),
"\n  acceptance rate, range:", range(M$acceptance),
"\n  effective sample size of the mode, min:", min(M$ess_mode), "\n")
# ---- Table for the appendix -------------------------------------------------
f2 = function(x) formatC(x, format = "f", digits = 2)
rows = sprintf("%s & %s & %s (%s, %s) & %s (%s, %s) & %s \\\\",
L$country, L$year,
f2(L$mean), f2(L$q025), f2(L$q975), f2(M$mean), f2(M$q025), f2(M$q975),
f2(M$acceptance))
tab = c("\\begin{table}[htb!]",
"\\centering",
"\\caption{RW2 posterior of the modal age at death computed with the Laplace approximation and with exact sampling (independence Metropolis--Hastings): posterior mean of $\\tilde{M}$ with 95\\% credible interval, and acceptance rate of the sampler. Women, starting age 50.}",
"\\label{tab:app_mcmc}",
"\\small",
"\\begin{tabular}{llccc}",
"\\hline",
" & & \\multicolumn{2}{c}{Modal age at death} & Acceptance \\\\",
"Country & Year & Laplace & Exact & rate \\\\",
"\\hline", rows, "\\hline", "\\end{tabular}", "\\end{table}")
save_table(tab, "app_laplace_mcmc.tex", "mcmc_check")
# ---- Figure -----------------------------------------------------------------
probs = probs[probs$prob >= 0.001, ]
probs$case = factor(probs$case, levels = unique(summ$case))
probs$method = factor(ifelse(probs$method == "MCMC", "Exact (MCMC)", "Laplace"),
levels = c("Laplace", "Exact (MCMC)"))
p = ggplot(probs, aes(age + 0.5, prob, fill = method)) +
geom_col(position = position_dodge(width = 0.8), width = 0.8) +
facet_wrap(~ case, nrow = 2, scales = "free") +
scale_fill_manual(values = c("Laplace" = "#0072B2", "Exact (MCMC)" = "#E69F00"),
name = NULL) +
labs(x = "Age", y = "P(mode = x | data)") +
theme_mode()
save_figure(p, "app_laplace_mcmc.pdf", "mcmc_check", 6)
cat("Saved to results/mcmc_check and figures/mcmc_check\n")
